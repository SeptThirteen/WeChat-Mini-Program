# 复制为 .env 后填写真实值;.env 已被 gitignore,严禁提交到仓库
# MySQL root 密码(强随机,>=16位)
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT 签名密钥(强随机,>=32字符,泄露任何人可伪造登录态)
# 生成示例: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

# 短信验证码演示开关:未接短信网关期间保持 true(响应回显 devCode);接入真实短信后必须改为 false
SMS_CODE_RETURN_IN_RESPONSE=true

# AI 引擎(二选一配置即可,主引擎失败自动切备用)
AI_DEFAULT_PROVIDER=BAIDU
AI_BAIDU_API_KEY=
AI_BAIDU_SECRET_KEY=
# 千帆V2 API密钥(bce-v3/ 开头,新账号对话必需):千帆控制台-API密钥创建
AI_BAIDU_CHAT_API_KEY=
AI_TENCENT_SECRET_ID=
AI_TENCENT_SECRET_KEY=
